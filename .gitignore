# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Backend dependencies and generated files
/backend/node_modules/
/backend/dist/
/backend/coverage/

# Environment files (root and backend)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Local database and logs
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
